{
  "name": "map-game",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:bun": "bunx --bun vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "husky",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:unit": "vitest",
    "test-old": "npm run test:unit -- --run && npm run test:e2e",
    "test": "vitest run",
    "test:silent": "vitest run --silent",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "seed": "npx tsx ./seed.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/better-sqlite3": "^7.6.13",
    "@vitest/ui": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "typescript": "~6.0.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@faker-js/faker": "^10.5.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "better-auth": "^1.6.26",
    "better-sqlite3": "^13.0.3",
    "dayjs": "^1.11.21",
    "drizzle-orm": "^0.45.2",
    "happy-dom": "^20.11.1",
    "map-game": ".",
    "sass": "^1.102.0",
    "valibot": "^1.4.2"
  }
